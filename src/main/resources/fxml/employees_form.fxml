<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import com.mebelsex.ui.components.SignedMoneyField?>

<VBox prefWidth="520" spacing="16" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mebelsex.ui.employees.EmployeeFormController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="titleLabel" styleClass="page-title"/>

    <VBox spacing="4">
        <Label text="%employee.form.name" styleClass="muted-text"/>
        <TextField fx:id="nameField" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="%employee.form.phone" styleClass="muted-text"/>
        <TextField fx:id="phoneField" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="%employee.form.position" styleClass="muted-text"/>
        <HBox spacing="8">
            <ComboBox fx:id="positionCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="addPositionButton" text="+" onAction="#handleAddPosition" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <VBox spacing="4">
        <Label text="%employee.form.opening" styleClass="muted-text"/>
        <SignedMoneyField fx:id="openingField" maxWidth="Infinity"/>
    </VBox>

    <CheckBox fx:id="activeCheck" text="%employee.form.active"/>

    <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="%action.cancel" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button fx:id="saveButton" text="%action.save" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>
</VBox>
