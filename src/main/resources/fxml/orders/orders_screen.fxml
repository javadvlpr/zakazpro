<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<?import com.mebelsex.ui.components.SearchField?>

<VBox spacing="16" stylesheets="@../../css/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mebelsex.ui.orders.OrdersController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="%orders.title" styleClass="header-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        
        <HBox alignment="CENTER" spacing="12">
            <ComboBox fx:id="statusFilter" prefWidth="180"/>
            <CheckBox fx:id="includeClosedCheck" text="%orders.filter.include_closed"/>
            <SearchField fx:id="searchField" promptText="%search.placeholder" prefWidth="300" styleClass="search-field"/>
            <Button fx:id="newOrderButton" text="%action.new" onAction="#handleNew" styleClass="primary-button">
                <graphic>
                    <FontIcon iconLiteral="fth-plus"/>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colNumber" text="№" prefWidth="50"/>
            <TableColumn fx:id="colOrderDate" text="%order.orderDate" prefWidth="100"/>
            <TableColumn fx:id="colDueDate" text="%order.dueDate" prefWidth="100"/>
            <TableColumn fx:id="colCustomer" text="%order.customer" prefWidth="200"/>
            <TableColumn fx:id="colProduct" text="%order.product" prefWidth="250"/>
            
            <TableColumn fx:id="colAgreedPrice" text="%order.price" prefWidth="150"/>
            <TableColumn fx:id="colPaid" text="%order.paid" prefWidth="150"/>
            <TableColumn fx:id="colDebt" text="%order.debt" prefWidth="150"/>
            
            <TableColumn fx:id="colStatus" text="%order.status" prefWidth="120"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="muted-icon"/>
                <Label text="%table.empty" styleClass="muted-text"/>
            </VBox>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Button fx:id="editButton" onAction="#handleEdit" text="%action.edit" styleClass="secondary-button" disable="true">
            <graphic>
                <FontIcon iconLiteral="fth-edit-2"/>
            </graphic>
        </Button>
        <Button fx:id="statusChangeButton" onAction="#handleStatusChange" text="%action.change_status" styleClass="secondary-button" disable="true">
            <graphic>
                <FontIcon iconLiteral="fth-repeat"/>
            </graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalDebtLabel" text="Jami qarz: 0 so'm" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
