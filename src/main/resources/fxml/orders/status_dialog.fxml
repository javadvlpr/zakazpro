<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" prefWidth="560" stylesheets="@../../css/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mebelsex.ui.orders.StatusDialogController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <FontIcon iconLiteral="fth-repeat" iconSize="24" styleClass="accent-icon"/>
        <Label text="%action.change_status" styleClass="page-title"/>
    </HBox>
    <Separator/>

    <VBox spacing="8">
        <Label text="%order.status" styleClass="form-label"/>
        <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="warningLabel" text="" wrapText="true" styleClass="warning-box" visible="false" managed="false"/>

    <Separator/>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button text="%action.cancel" onAction="#handleCancel" styleClass="secondary-button" minWidth="90"/>
        <Button fx:id="saveButton" text="%action.save" onAction="#handleSave" styleClass="primary-button" minWidth="100"/>
    </HBox>
</VBox>
